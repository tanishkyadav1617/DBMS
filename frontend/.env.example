# ==============================================================================
# Frontend Environment Variables Template
# ==============================================================================

# Backend API Root URL:
# IMPORTANT:
# 1. Do NOT include a trailing slash (/)
# 2. Do NOT append '/api' (the frontend code automatically prefixes all routes with '/api')

# For Local Development:
REACT_APP_API_BASE_URL=http://localhost:8000

# For Production (e.g. Render, Railway, VPS, EC2):
# REACT_APP_API_BASE_URL=https://your-flask-backend.onrender.com

# API Request Timeout (in milliseconds)
REACT_APP_API_TIMEOUT_MS=10000
