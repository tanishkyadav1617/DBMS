# ==============================================================================
# Frontend Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env in the frontend directory.
# In Create React App, environment variables must start with REACT_APP_.
# ==============================================================================

# ── API Connection ────────────────────────────────────────────────────────────
# Base URL for Flask backend API (without trailing slash)
REACT_APP_API_BASE_URL=http://localhost:8000
REACT_APP_API_URL=http://localhost:8000

# Axios HTTP request timeout in milliseconds
REACT_APP_API_TIMEOUT_MS=10000

# ── Role Domain Suffixes ──────────────────────────────────────────────────────
# Email domain requirements used for role authentication in the UI
REACT_APP_MANAGER_DOMAIN=manager.com
REACT_APP_CUSTOMER_DOMAIN=customer.com
REACT_APP_DELIVERY_DOMAIN=delpart.com

# ── Demo Quick Login Credentials (Optional) ───────────────────────────────────
# Pre-populated test accounts displayed on the login screen for 1-click testing
REACT_APP_DEMO_PASSWORD=password123
REACT_APP_DEMO_MANAGER_EMAIL=tanishk@manager.com
REACT_APP_DEMO_CUSTOMER_EMAIL=agam@customer.com
REACT_APP_DEMO_DELIVERY_EMAIL=chauhan@delpart.com
