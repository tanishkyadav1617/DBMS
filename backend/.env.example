# ==============================================================================
# Backend Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure the values for your environment.
# All variables will be loaded automatically by backend/config.py via python-dotenv.
# ==============================================================================

# ── Server Execution ──────────────────────────────────────────────────────────
# Environment mode (development / production)
FLASK_ENV=development

# Bind host (0.0.0.0 listens on all network interfaces; 127.0.0.1 for local only)
FLASK_HOST=0.0.0.0

# Port number for the Flask server
FLASK_PORT=8000

# Enable/disable debug mode and auto-reloader (true / false)
FLASK_DEBUG=false

# ── Security & CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Secret key used for signing JWT access tokens (use a 64+ char random hex string)
JWT_SECRET_KEY=your_jwt_secret_key_here_generate_with_secrets_token_hex_32

# Token lifespan in minutes. Set to 0 to disable expiration (infinite for demos)
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=0

# ── Database Connection ───────────────────────────────────────────────────────
# MySQL database host
DB_HOST=localhost

# MySQL database port (default 3306)
DB_PORT=3306

# MySQL database name
DB_NAME=inventory_db

# MySQL username
DB_USER=root

# MySQL password
DB_PASSWORD=your_mysql_password_here

# Connection pool size
DB_POOL_SIZE=10

# ── Domain & Business Logic Rules (RBAC) ──────────────────────────────────────
# Email domain suffixes used for strictly deriving user roles upon login
MANAGER_EMAIL_DOMAIN=manager.com
CUSTOMER_EMAIL_DOMAIN=customer.com
DELIVERY_EMAIL_DOMAIN=delpart.com

# ── Delivery Performance Index (DPI) Constants ────────────────────────────────
# Formula: (DPI_WEIGHT_SUCCESSFUL * Delivered) - (DPI_WEIGHT_FAILED * Not Delivered) + (DPI_WEIGHT_DISTANCE * Total KM)
DPI_WEIGHT_SUCCESSFUL=10.0
DPI_WEIGHT_FAILED=5.0
DPI_WEIGHT_DISTANCE=1.0

# ── Order Limits & Thresholds ─────────────────────────────────────────────────
# Minimum allowable delivery distance in kilometers
MIN_ORDER_DISTANCE_KM=0.1

# Minimum estimated delivery time in minutes
MIN_ETA_MINUTES=1
