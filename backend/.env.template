# ==============================================================================
# Backend Environment Configuration Template (.env.template)
# ==============================================================================
# Copy this file to .env and configure the values for your environment.
# ==============================================================================

# ── Server Execution ──────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
FLASK_DEBUG=false

# ── Security & CORS ───────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET_KEY=your_jwt_secret_key_here_generate_with_secrets_token_hex_32
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=0

# ── Database Connection ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventory_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_POOL_SIZE=10

# ── Domain & Business Logic Rules (RBAC) ──────────────────────────────────────
MANAGER_EMAIL_DOMAIN=manager.com
CUSTOMER_EMAIL_DOMAIN=customer.com
DELIVERY_EMAIL_DOMAIN=delpart.com

# ── Delivery Performance Index (DPI) Constants ────────────────────────────────
DPI_WEIGHT_SUCCESSFUL=10.0
DPI_WEIGHT_FAILED=5.0
DPI_WEIGHT_DISTANCE=1.0

# ── Order Limits & Thresholds ─────────────────────────────────────────────────
MIN_ORDER_DISTANCE_KM=0.1
MIN_ETA_MINUTES=1
